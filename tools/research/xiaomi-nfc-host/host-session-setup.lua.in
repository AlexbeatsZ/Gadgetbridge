-- Bounded synthetic RF session. Recovery runs in NSH outside the face thread.
-- Resident code is NOT unloaded by the background script: collector verifies
-- callback ownership/quiescence, original table and slots before unloading.
local base="/data/quickapp/files/com.meta.s4nativeprobe"
local ready=io.open(base.."/ready.txt","r");if not ready then return end;ready:close()
local done=io.open(base.."/@RUN_ID@-setup-done.txt","r");if done then done:close();return end
local result={"RUN=@RUN_ID@; synthetic fixed-response host setup; window=@WINDOW@ seconds"}
@COMMON_HELPERS@
local payloads={@PAYLOADS@}
local prepared=true
for _,p in ipairs(payloads)do if not emit(p[1]..".elf",p[2])then prepared=false end end
local function bind(name,hex,target)
 local b={};for i=1,4 do b[#b+1]=string.format("%02x",target%256);target=math.floor(target/256)end
 local patched,count=hex:gsub("dec0adde",table.concat(b))
 return count==1 and emit(name..".elf",patched)
end
command("modules-before.txt","lsmod")
local started=false
if prepared and not read("modules-before.txt"):find("gb_",1,true) and query("nfc-proc.txt")=="61020c00020003c0e3000003c0e302" and discovery("stop")then
 command("work-load.txt","insmod "..base.."/host-test-session.elf gb_host_test")
 command("work-sleep.txt","sleep 1")
 local addr=moduleData("gb_host_test")
 if addr then
  command("host-help.txt","xd "..addr.." 296");local h=words("host-help.txt")
  result[#result+1]="SESSION_DATA="..addr..";phase="..tostring(h[2])
  if #h==74 and h[1]==0x53483454 and h[2]==3 and h[5]==1 and h[20]==1 and rawIdle() and
     bind("host-test-arm-bound","@ARM_HEX@",tonumber(addr)) and
     bind("host-test-remove-bound","@REMOVE_HEX@",tonumber(addr)) and
     bind("host-test-stop-bound","@STOP_OWNED_HEX@",tonumber(addr))then
   local script={
    "insmod "..base.."/test-route-append.elf gb_route_append",
    "sleep 1",
    "insmod "..base.."/discovery-start.elf gb_host_start",
    "rmmod gb_host_start",
    "sleep 1",
    "insmod "..base.."/host-test-arm-bound.elf gb_host_arm",
    "rmmod gb_host_arm",
    "sleep 1",
    "xd "..addr.." 296 > "..base.."/shell-help.txt",
    "xd 3c2d4754 40 > "..base.."/nfc-fds.txt",
    "echo HOST_TEST_WINDOW_@RUN_ID@ > "..base.."/version.txt",
   }
   -- NSH rejects sleep 0 and aborts the script. An empty window must omit it.
   if @WINDOW@ > 0 then script[#script+1]="sleep @WINDOW@"end
   -- Bounded STOP refuses an original eSE active handle. Repeated attempts do
   -- not extend the test window; they allow a pending test deactivation to end.
   for i=1,3 do
    script[#script+1]="insmod "..base.."/host-test-stop-bound.elf gb_host_stop"
    script[#script+1]="rmmod gb_host_stop"
    script[#script+1]="sleep 1"
   end
   script[#script+1]="insmod "..base.."/get-routing-status.elf gb_host_hal_barrier"
   script[#script+1]="sleep 1"
   script[#script+1]="insmod "..base.."/test-route-restore.elf gb_route_restore"
   script[#script+1]="sleep 1"
   for i=1,3 do
    script[#script+1]="insmod "..base.."/host-test-remove-bound.elf gb_host_remove"
    script[#script+1]="rmmod gb_host_remove"
    script[#script+1]="sleep 1"
   end
   script[#script+1]="insmod "..base.."/discovery-start.elf gb_host_restart"
   script[#script+1]="rmmod gb_host_restart"
   script[#script+1]="sleep 1"
   script[#script+1]="xd "..addr.." 296 > "..base.."/fd-help.txt"
   script[#script+1]="xd 3c2d4754 40 > "..base.."/nfc-mqueue.txt"
   script[#script+1]="xd 3c2d4746 4 > "..base.."/modules.txt"
   script[#script+1]="xd 3c2d4c30 4 > "..base.."/device-list.txt"
   script[#script+1]="xd 3c2d4b90 4 > "..base.."/process-list.txt"
   script[#script+1]="xd 3c2d46d4 4 > "..base.."/proc-list.txt"
   script[#script+1]="lsmod > "..base.."/modules-final.txt"
   script[#script+1]="echo RECOVERY_SEQUENCE_FINISHED_@RUN_ID@ > "..base.."/version.txt"
   local f=io.open(base.."/host-session-background.sh","w")
   if f then
    f:write(table.concat(script,"\n").."\n");f:close()
    local ok,a,b,c=pcall(function()return os.execute("sh "..base.."/host-session-background.sh > "..base.."/modules-after.txt &")end)
    started=ok and a==true and c==0
    result[#result+1]="BACKGROUND_RETURN="..tostring(ok)..","..tostring(a)..","..tostring(b)..","..tostring(c)
   end
  end
 end
 if not started then result[#result+1]="SETUP_NOT_STARTED_RESIDENT_REQUIRES_INSPECTION";discovery("start")end
else result[#result+1]="PREFLIGHT_REJECTED_NO_HOST_SESSION"end
result[#result+1]="BACKGROUND_LAUNCHED="..tostring(started)
local f=io.open(base.."/lua-result.txt","w");if f then f:write(table.concat(result,"\n"));f:close()end
f=io.open(base.."/@RUN_ID@-setup-done.txt","w");if f then f:write("done");f:close()end
